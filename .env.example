# Plantilla de variables de entorno de Vedra.
# Copia este fichero a `.env` (ya ignorado por git) y rellena los valores.
# NUNCA se commitean valores reales: solo esta plantilla vacía.

# --- Supabase: enlazar la CLI y aplicar migraciones ---
# Project ref: aparece en la URL del proyecto (https://<ref>.supabase.co).
SUPABASE_PROJECT_REF=tu-project-ref
# DB password: la que fijaste al crear el proyecto (Database settings).
SUPABASE_DB_PASSWORD=
# Personal Access Token de la CLI: Dashboard > Account > Access Tokens.
SUPABASE_ACCESS_TOKEN=

# --- Conexión REST (motor lee con anon; ingesta escribe con service) ---
# SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# --- Curación asistida de normativa (se rellena en su fase) ---
ANTHROPIC_API_KEY=
